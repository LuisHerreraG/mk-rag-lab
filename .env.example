# Copiá este archivo a una ruta FUERA del repo y apuntá MK_RAG_ENV_FILE a ella.
# Por defecto el código lee $XDG_CONFIG_HOME/mk-rag-lab/env (~/.config/mk-rag-lab/env)
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com
AZURE_OPENAI_KEY=...
AZURE_OPENAI_DEPLOYMENT_CHAT=chat
AZURE_OPENAI_DEPLOYMENT_EMBED=embed
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_SEARCH_ENDPOINT=https://<tu-servicio>.search.windows.net
AZURE_SEARCH_KEY=...
AZURE_SEARCH_INDEX=mk-rag-lab
